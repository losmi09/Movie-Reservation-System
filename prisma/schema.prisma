generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id            String     @id @default(uuid())
  title         String     @unique @db.VarChar(255)
  description   String     @db.VarChar(255)
  posterImage   String     @default("default.jpg") @map("poster_image") @db.Text
  slug          String     @db.VarChar(255)
  reviewsCount  Int        @default(0) @map("reviews_count")
  averageRating Int        @default(0) @map("average_rating")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  Showtime      Showtime[]
  Review        Review[]

  @@index([createdAt, id])
  @@map("movies")
}

model User {
  id                           String        @id @default(uuid())
  firstName                    String        @map("first_name") @db.VarChar(255)
  lastName                     String        @map("last_name") @db.VarChar(255)
  email                        String        @unique @db.VarChar(255)
  photo                        String        @default("default.jpg") @db.Text
  role                         Role          @default(user)
  password                     String        @db.VarChar(255)
  passwordChangedAt            DateTime?     @map("password_changed_at")
  passwordResetToken           String?       @unique @map("password_reset_token")
  passwordResetTokenExpiry     DateTime?     @map("password_reset_token_expiry")
  emailVerificationToken       String?       @unique @map("email_verification_token")
  emailVerificationTokenExpiry DateTime?     @map("email_verification_token_expiry")
  isVerified                   Boolean       @default(false) @map("is_verified")
  isActive                     Boolean       @default(true) @map("is_active")
  createdAt                    DateTime      @default(now()) @map("created_at")
  updatedAt                    DateTime      @updatedAt @map("updated_at")
  Reservation                  Reservation[]
  Review                       Review[]

  @@map("users")
}

enum Role {
  user
  admin
}

model Cinema {
  id        String     @id @default(uuid())
  name      String     @unique @db.VarChar(255)
  city      String     @db.VarChar(255)
  address   String     @db.VarChar(255)
  phone     String     @unique @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
  slug      String     @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  halls     Hall[]
  Showtime  Showtime[]

  @@unique([name, city])
  @@index([createdAt, id])
  @@map("cinemas")
}

model Hall {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(255)
  maxRows   Int        @map("max_rows")
  cinemaId  String     @map("cinema_id")
  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  Showtime  Showtime[]
  Row       Row[]

  @@unique([cinemaId, name])
  @@index([cinemaId, createdAt, id])
  @@map("halls")
}

model Row {
  id           String   @id @default(uuid())
  label        String   @db.VarChar(255)
  seatCapacity Int      @map("seat_capacity")
  hallId       String   @map("hall_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  hall         Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  Seat         Seat[]

  @@unique([label, hallId])
  @@index([createdAt, id])
  @@map("rows")
}

model Seat {
  id          String        @id @default(uuid())
  rowId       String        @map("row_id")
  row         Row           @relation(fields: [rowId], references: [id], onDelete: Cascade)
  number      Int
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  Reservation Reservation[]

  @@unique([rowId, number])
  @@index([createdAt, id])
  @@map("seats")
}

model Showtime {
  id          String        @id @default(uuid())
  movieId     String        @map("movie_id")
  movie       Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  cinemaId    String        @map("cinema_id")
  cinema      Cinema        @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  hallId      String        @map("hall_id")
  hall        Hall          @relation(fields: [hallId], references: [id], onDelete: Cascade)
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  language    String        @default("English") @db.VarChar(255)
  price       Decimal
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  Reservation Reservation[]

  @@unique([movieId, cinemaId, hallId, startTime])
  @@index([createdAt, id])
  @@map("showtimes")
}

model Reservation {
  id         String   @id @default(uuid())
  showtimeId String   @map("showtime_id")
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId     String?  @map("seat_id")
  seat       Seat?    @relation(fields: [seatId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     Status   @default(reserved)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // There is alse a unique composite partial index (added by a manual migration) that cannot be displayed in the schema, it allows only one reservation for a specific showtime and seat with the status reserved

  @@index([createdAt, id])
  @@map("reservations")
}

enum Status {
  available
  reserved
  cancelled
  waitlist
}

model Review {
  id        String   @id @default(uuid())
  movieId   String   @map("movie_id")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String   @db.VarChar(255)
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([movieId, userId])
  @@index([createdAt, id])
  @@map("reviews")
}
